-- ================== HOOK SILENT AIM ==================
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if Config.Aim and (method == "FireServer" or method == "InvokeServer") then
        local n = tostring(self.Name):lower()
        if n:find("shoot") or n:find("hit") or n:find("knife") or n:find("gun") or n:find("attack") or n:find("damage") then
            local t = pickTarget()
            local part = getAimPart(t)
            if part then
                local args = {...}
                table.insert(args, part)
                return oldNamecall(self, unpack(args))
            end
        end
    end
    return oldNamecall(self, ...)
end)

