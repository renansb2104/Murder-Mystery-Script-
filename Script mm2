local isTPing = false
btnTP.MouseButton1Click:Connect(function()
    if isTPing then return end
    isTPing = true
    local myChar = LP.Character
    if not myChar then isTPing = false; return end
    
    local myPos = myChar:FindFirstChild("HumanoidRootPart") and myChar.HumanoidRootPart.Position or Vector3.zero
    local closestTool = nil
    local minDist = 200
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if (n == "knife" or n == "gun") and not n:find("display") and not n:find("spawn") and not n:find("stuck") then
                local parent = obj:FindFirstAncestorOfClass("Model")
                local held = false
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character == parent then held = true; break end
                end
                if not held then
                    local d = (obj.Position - myPos).Magnitude
                    if d < minDist then closestTool = parent; minDist = d end
                end
            end
        end
    end
    
    if closestTool then
        if closestTool:IsA("Tool") then closestTool.Parent = myChar
        elseif closestTool:FindFirstChildOfClass("Tool") then closestTool:FindFirstChildOfClass("Tool").Parent = myChar end
    end
    task.wait(0.2)
    isTPing = false
end)

